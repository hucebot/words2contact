root ::= Prompt
Prompt ::= "{"   ws   "\"chain_of_thought\":"   ws   string   ","   ws   "\"objects\":"   ws   stringlist   "}"
Promptlist ::= "[]" | "["   ws   Prompt   (","   ws   Prompt)*   "]"
string ::= "\""   ([^"]*)   "\""
ws ::= [ \t\n]*
stringlist ::= "["   ws   "]" | "["   ws   string   (","   ws   string)*   ws   "]"
